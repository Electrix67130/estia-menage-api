# Template du .env de PRODUCTION (phase pilote Estia, déploiement Docker).
# Copier en .env sur le VPS, remplir les <...>, puis `chmod 600 .env`.
# Ce fichier est lu à la fois par l'API et par docker-compose.prod.yml.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Base de données — DB_HOST est surchargé en "db" par le compose.
DB_HOST=db
DB_PORT=5432
DB_NAME=estia_menage
DB_USER=estia
DB_PASSWORD=<MOT_DE_PASSE_FORT>

# Auth — générer avec : openssl rand -hex 64
JWT_SECRET=<openssl rand -hex 64>
JWT_ACCESS_EXPIRES=15m
API_KEY=<openssl rand -hex 32>

# URL publique de l'API (sert à construire les liens de fichiers et d'emails).
APP_URL=https://api.estia-clean-connect.fr

# Email transactionnel — Scaleway TEM (SMTP, via nodemailer).
SMTP_HOST=smtp.tem.scw.cloud
SMTP_PORT=587
SMTP_USER=<project_id>
SMTP_PASSWORD=<api_secret>
SMTP_FROM=noreply@estia-clean-connect.fr

# Stockage photos — Scaleway Object Storage (S3-compatible).
STORAGE_MODE=s3
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_BUCKET=estia-menage-photos
S3_REGION=fr-par
S3_ACCESS_KEY=<SCW_ACCESS_KEY>
S3_SECRET_KEY=<SCW_SECRET_KEY>
